# Appwrite configuration for OpenCommit.
# These values are injected at build time by Netlify or local dev.
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_DATABASE_ID=your-database-id
VITE_APPWRITE_COMMITS_COLLECTION_ID=commits-collection-id
VITE_APPWRITE_COMMIT_FUNCTION_ID=commit-function-id
VITE_VERIFIED_USER_ID=verified-user-id
